<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.sundaran" name="Sundaran Video" version="1.1.0" provider-name="YourName">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Browse and play videos from Sundaran's Cloudflare Worker</summary>
        <description lang="en_GB">This addon allows you to browse folders and play videos hosted on a Cloudflare Worker.</description>
        <platform>all</platform>
        <language>en</language>
        <license>MIT</license>
        <source>https://github.com/yourusername/plugin.video.sundaran</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>